---
import LanguageToggle from "./LanguageToggle.astro";
import { localizedPath } from "../lib/i18n";

interface Props {
  lang: "en" | "es";
  currentPath: string;
  floatingViewport?: boolean;
  showLanguageToggle?: boolean;
  brand: string;
  languageLabel: string;
  nav: {
    missions: string;
    start: string;
    stories: string;
    safety: string;
  };
  language: {
    en: string;
    es: string;
  };
}

const { lang, currentPath, floatingViewport = false, showLanguageToggle = true, brand, languageLabel, nav, language } = Astro.props;
const navItems = [
  { href: localizedPath(lang, "/roadmap"), label: nav.missions, key: "/roadmap" },
  { href: localizedPath(lang, "/"), label: nav.start, key: "/" },
  { href: localizedPath(lang, "/community"), label: nav.stories, key: "/community" },
  { href: localizedPath(lang, "/safety"), label: nav.safety, key: "/safety" }
];
---

<header
  class:list={["c-header", "c-nav-sticky", "c-nav-floating", "c-nav-glass", floatingViewport && "c-home-nav-fixed"]}
  data-stam-block="N-01"
>
  <div class="c-header-row">
    <a href={lang === "es" ? "/es" : "/"} class="c-brand" aria-label={brand}>
      <img src="/images/fambit-logo-nav.png" alt={brand} class="c-brand-logo" loading="eager" decoding="async" />
    </a>
    <nav aria-label="Primary" class="c-primary-nav" data-stam-block="N-02">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            aria-current={currentPath === item.key ? "page" : undefined}
            class="c-nav-link"
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    {
      showLanguageToggle && (
        <div class="c-header-lang-slot" data-stam-block="N-03">
          <LanguageToggle active={lang} basePath={currentPath} label={languageLabel} language={language} />
        </div>
      )
    }
  </div>
</header>
